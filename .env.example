# Puerto donde correrá el servidor Express
PORT=3001

# Entorno de ejecución (development, production)
NODE_ENV=production

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000,https://tu-dominio.com

# URL del webhook de Next.js (donde se envían los mensajes recibidos)
NEXTJS_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook

# Secreto de autenticación para el webhook (CAMBIA ESTO EN PRODUCCIÓN!)
WHATSAPP_SECRET=tu-secreto-super-seguro-aqui

# Carpeta donde se guardan las credenciales de WhatsApp
AUTH_FOLDER=auth_info

# Nivel de logs de Baileys (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=silent

# URL base de la aplicación Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secreto para autenticar las peticiones del cron
CRON_SECRET=tu-secreto-cron-aqui
